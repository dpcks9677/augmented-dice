rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function modeStats(data, mode) {
      return data.get('stats', {}).get('modes', {}).get(mode, {});
    }

    function modeRating(data, mode) {
      return modeStats(data, mode).get('rating', 500);
    }

    function modeRatingGames(data, mode) {
      return modeStats(data, mode).get('ratingGames', 0);
    }

    function modeRatingHistory(data, mode) {
      return modeStats(data, mode).get('ratingHistory', []);
    }

    function ratingFieldsUnchanged(mode) {
      return modeRating(request.resource.data, mode) == modeRating(resource.data, mode)
        && modeRatingGames(request.resource.data, mode) == modeRatingGames(resource.data, mode)
        && modeRatingHistory(request.resource.data, mode) == modeRatingHistory(resource.data, mode);
    }

    function ratingsInitialized() {
      return modeRating(request.resource.data, 'normal') == 500
        && modeRating(request.resource.data, 'augmented') == 500
        && modeRatingGames(request.resource.data, 'normal') == 0
        && modeRatingGames(request.resource.data, 'augmented') == 0
        && modeRatingHistory(request.resource.data, 'normal') == []
        && modeRatingHistory(request.resource.data, 'augmented') == [];
    }

    function ratingsUnchanged() {
      return ratingFieldsUnchanged('normal')
        && ratingFieldsUnchanged('augmented')
        && request.resource.data.get('stats', {}).get('ratingVersion', 0)
          == resource.data.get('stats', {}).get('ratingVersion', 0);
    }
    
    // 유저 정보 (본인 수정 + 로그인 사용자의 조회수 1 증가만 허용)
    match /users/{userId} {
      allow read: if true;
      allow create: if request.auth != null && request.auth.uid == userId && ratingsInitialized();
      allow delete: if false;
      allow update: if request.auth != null && (
          (request.auth.uid == userId && ratingsUnchanged()) ||
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['profileViews']) &&
          request.resource.data.profileViews == resource.data.get('profileViews', 0) + 1
        )
      );

      match /augmentStatReceipts/{receiptId} {
        allow read, create: if request.auth != null && request.auth.uid == userId;
        allow update, delete: if false;
      }
    }
    
    // 경기 기록 (참가한 로그인 유저만 생성 가능, 데이터 스키마 유효성 검사)
    match /matches/{matchId} {
      allow read: if true;
      allow create: if request.auth != null 
                    && request.resource.data.playerUids is list 
                    && request.resource.data.playerUids.size() <= 4
                    && request.auth.uid in request.resource.data.playerUids
                    && request.resource.data.get('sessionType', 'lobby') != 'matchmaking'
                    && !matchId.matches('^match-[A-Za-z0-9-]+$');
      allow update, delete: if false;
    }
    
    // 기본적으로 기타 경로 차단
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
